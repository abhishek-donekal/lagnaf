{
  "redirects": [
    {
      "source": "https://www.lagnafnetwork.com/(.*)",
      "destination": "https://lagnafnetwork.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/hs", "destination": "/api/hs" },
    { "source": "/(.*)",   "destination": "/$1" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml" }]
    }
  ]
}
